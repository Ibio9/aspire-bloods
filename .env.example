# --- Core ---
NODE_ENV=development
PORT=4000
# APP_BASE_URL is also the CORS allow-origin in production — the frontend
# and API are separate deploys (Vercel + Railway), so this must be the
# exact frontend origin with no trailing slash, e.g.
# https://blood.aspireshield.com
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

# --- Database (Railway provides DATABASE_URL automatically in production) ---
DATABASE_URL=postgresql://aspire:aspire_dev_password@localhost:5432/aspire_bloods

# --- Auth / sessions ---
JWT_ACCESS_SECRET=replace-with-64-char-random-hex
JWT_REFRESH_SECRET=replace-with-different-64-char-random-hex
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
TRUSTED_DEVICE_TTL_DAYS=30
# In production this must be the shared parent domain — NO leading dot
# (e.g. blood.aspireshield.com, not .blood.aspireshield.com) — so the
# session cookie set by api.blood.aspireshield.com is also valid for
# blood.aspireshield.com. RFC 6265 domain-matching already includes
# subdomains without the dot; the old leading-dot syntax is unnecessary
# and at least one cookie library in this app's dependency tree rejects it
# outright ("option domain is invalid"), which crashes the request the
# first time a cookie is actually set (login/OTP-verify). The app refuses
# to boot in production with a leading dot here — see productionBootChecks.ts.
# Without this var set correctly at all, the cookie is scoped to the API
# subdomain only and the frontend never sees it. See DEPLOYMENT.md.
COOKIE_DOMAIN=localhost
CSRF_SECRET=replace-with-64-char-random-hex

# --- Field-level encryption (AES-256-GCM, 32-byte key, base64) ---
ENCRYPTION_KEY=replace-with-base64-32-byte-key

# --- Signed file URLs (local disk storage adapter) ---
FILE_SIGNING_SECRET=replace-with-64-char-random-hex
FILE_URL_TTL_MINUTES=10
# In production this must point at the mounted Railway volume (e.g.
# /data/storage), not the container's own ephemeral filesystem — anything
# written outside the volume is lost on the next deploy. See DEPLOYMENT.md.
STORAGE_ROOT=./storage

# --- Email (Resend) ---
# Required in production — the app refuses to boot without it. Without a
# real key, the email provider falls back to printing emails (including
# OTP codes and patient addresses) to the server console, which would put
# PII in Railway's logs.
RESEND_API_KEY=
EMAIL_FROM="Aspire Clinic <no-reply@aspireshield.com>"

# --- SMS (Twilio) — disabled by default, interface-only until enabled ---
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Clinical escalation routing ---
ESCALATION_EMAIL=clinical-team@aspireshield.com
ESCALATION_SMS_NUMBER=

# --- Patient-facing clinic contact details ---
# Shown in the patient portal's sidebar on every screen, and again beside
# anything out of range. CLINIC_PHONE is deliberately blank by default: the
# portal omits the phone row entirely until a real, answered number is set,
# rather than printing one that rings nowhere. Address and email come from
# the code (apps/server/src/modules/content/clinicContact.ts).
CLINIC_PHONE=
CLINIC_HOURS=Monday to Friday, 9am – 5pm

# --- Admin access ---
# Comma-separated list of email addresses granted the ADMIN role. Parsed
# at boot (trimmed, lowercased, empties ignored) and re-checked on every
# request — there is no other way to become an admin anywhere in this
# codebase (no route, no setting, no seed script, no UI toggle). Required
# in production; the app refuses to boot without it. To change who has
# admin access in production: edit this variable in the Railway dashboard
# and redeploy — see DEPLOYMENT.md.
#
# /signup is open to everyone now (patients register themselves), which
# changes nothing here: an account created there is always stored as a
# patient, and the console appears only for addresses on this list, checked
# per request. Removing someone from this list demotes their existing
# account to patient-level access on their very next request; it does not
# lock them out or delete anything.
ADMIN_EMAILS=

# --- Randox lab integration ---
LAB_ADAPTER=RANDOX_PORTAL
# RANDOX_API_* only used once RandoxApiAdapter is activated (requires paid API access)
RANDOX_API_BASE_URL=
RANDOX_API_KEY=

# --- Dev/test only — NEVER true anywhere internet-reachable ---
# Returns the raw 2FA code in the login API response so local dev and e2e
# tests don't need to read it from the email provider log. Leaving this
# true in a real deployment is a full 2FA bypass.
EXPOSE_DEV_OTP_CODE=false

# --- Demo data (prisma/seedDemo.ts) ---
# SYNTHETIC patient + 4 released reports, for showing the portal before real
# patients exist. When true, the API container re-seeds it on every boot
# (idempotently, re-anchoring the report dates to "now"); unset or false and
# the boot-time call is a silent no-op. This is also the explicit opt-in that
# lets the demo seed run at all under NODE_ENV=production.
# Turn OFF and run `npm run prisma:seed:demo -- --purge --allow-production`
# before the first real patient is onboarded.
SEED_DEMO_DATA=false
# The demo patient still has to pass 2FA, so wherever email is genuinely
# being sent this must be a mailbox you can actually open.
SEED_DEMO_EMAIL=demo.showcase@aspireshield.dev
SEED_DEMO_PASSWORD=

# --- Email verification (self-signup) ---
# How long the "confirm your email" link stays good for. Short on purpose:
# it only has to survive someone switching to their inbox.
EMAIL_VERIFICATION_TTL_HOURS=24

# --- Password reset ---
# How long a "reset your password" link stays good for, in MINUTES (not
# hours). Unlike a verification link, this one can take over an account, so
# its window is the time it takes to open an inbox and nothing more. Each
# link is single-use, issuing a new one spends any link still outstanding,
# and using one revokes every live session on the account.
PASSWORD_RESET_TTL_MINUTES=60

# --- Rate limiting / login lockout ---
# Windows are in SECONDS, not minutes — the login window is now short enough
# that minutes can't express it.
#
# The lockout stays: it's the only thing standing between someone and
# brute-forcing patient records. But the old 5-in-15-minutes fired on
# ordinary human mistyping and shut real patients out of their own results
# for a quarter of an hour. Ten attempts inside two minutes is far below any
# useful guessing rate, effectively unreachable by hand, and the counter is
# cleared outright on any successful sign-in — so a person who fumbles their
# password and then gets it right doesn't start their next sign-in halfway
# to a lock. Both numbers are tunable here without a deploy.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=120
# Deliberately NOT loosened alongside login. A six-digit code has a search
# space of one million, and whoever reached this step already holds a valid
# password — a generous allowance here is a materially different risk.
OTP_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_WINDOW_SECONDS=900
# "Send me a new code" has its own budget, separate from OTP verification:
# resend causes an outbound email/SMS, and a patient legitimately asking for
# a second code must not thereby lose the attempts they need to enter it.
# The per-attempt cooldown (30s) and reissue cap (3) in auth/service.ts are
# the primary control; this is the backstop.
OTP_RESEND_RATE_LIMIT_MAX=4
# Registration is open to anyone (patients register themselves at /signup),
# so this is an anti-abuse ceiling on how many accounts one connection can
# create — not a gate on who may register.
SIGNUP_RATE_LIMIT_MAX=10
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Web app (Vite build-time) ---
# The clinic's public phone number. Every "we couldn't get you signed in,
# call us" affordance in the app lights up when this is set, and falls back
# to the clinical-team email address when it isn't. Deliberately has no
# hard-coded default: inventing a phone number for a real medical practice
# risks sending patients to a stranger. Set it to the practice's published
# number in the Vercel environment before go-live.
VITE_CLINIC_PHONE=
