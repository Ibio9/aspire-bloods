# --- Core ---
NODE_ENV=development
PORT=4000
# APP_BASE_URL is also the CORS allow-origin in production — the frontend
# and API are separate deploys (Vercel + Railway), so this must be the
# exact frontend origin with no trailing slash, e.g.
# https://blood.aspireshield.com
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

# --- Database (Railway provides DATABASE_URL automatically in production) ---
DATABASE_URL=postgresql://aspire:aspire_dev_password@localhost:5432/aspire_bloods

# --- Auth / sessions ---
JWT_ACCESS_SECRET=replace-with-64-char-random-hex
JWT_REFRESH_SECRET=replace-with-different-64-char-random-hex
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
TRUSTED_DEVICE_TTL_DAYS=30
# In production this must be the shared parent domain — NO leading dot
# (e.g. blood.aspireshield.com, not .blood.aspireshield.com) — so the
# session cookie set by api.blood.aspireshield.com is also valid for
# blood.aspireshield.com. RFC 6265 domain-matching already includes
# subdomains without the dot; the old leading-dot syntax is unnecessary
# and at least one cookie library in this app's dependency tree rejects it
# outright ("option domain is invalid"), which crashes the request the
# first time a cookie is actually set (login/OTP-verify). The app refuses
# to boot in production with a leading dot here — see productionBootChecks.ts.
# Without this var set correctly at all, the cookie is scoped to the API
# subdomain only and the frontend never sees it. See DEPLOYMENT.md.
COOKIE_DOMAIN=localhost
CSRF_SECRET=replace-with-64-char-random-hex

# --- Field-level encryption (AES-256-GCM, 32-byte key, base64) ---
ENCRYPTION_KEY=replace-with-base64-32-byte-key

# --- Signed file URLs (local disk storage adapter) ---
FILE_SIGNING_SECRET=replace-with-64-char-random-hex
FILE_URL_TTL_MINUTES=10
# In production this must point at the mounted Railway volume (e.g.
# /data/storage), not the container's own ephemeral filesystem — anything
# written outside the volume is lost on the next deploy. See DEPLOYMENT.md.
STORAGE_ROOT=./storage

# --- Email (Resend) ---
# Required in production — the app refuses to boot without it. Without a
# real key, the email provider falls back to printing emails (including
# OTP codes and patient addresses) to the server console, which would put
# PII in Railway's logs.
RESEND_API_KEY=
EMAIL_FROM="Aspire Clinic <no-reply@aspireshield.com>"

# --- SMS (Twilio) — disabled by default, interface-only until enabled ---
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Clinical escalation routing ---
ESCALATION_EMAIL=clinical-team@aspireshield.com
ESCALATION_SMS_NUMBER=

# --- Patient-facing clinic contact details ---
# Shown in the patient portal's sidebar on every screen, and again beside
# anything out of range. CLINIC_PHONE is deliberately blank by default: the
# portal omits the phone row entirely until a real, answered number is set,
# rather than printing one that rings nowhere. Address and email come from
# the code (apps/server/src/modules/content/clinicContact.ts).
CLINIC_PHONE=
CLINIC_HOURS=Monday to Friday, 9am – 5pm

# --- Admin access ---
# Comma-separated list of email addresses granted the ADMIN role. Parsed
# at boot (trimmed, lowercased, empties ignored) and re-checked on every
# request — there is no other way to become an admin anywhere in this
# codebase (no route, no setting, no seed script, no UI toggle). Required
# in production; the app refuses to boot without it. To change who has
# admin access in production: edit this variable in the Railway dashboard
# and redeploy — see DEPLOYMENT.md.
#
# Anyone whose email is on this list can self-register at /signup — that
# endpoint rejects every other address with an identical generic message,
# so it never reveals list membership. Removing someone from this list
# demotes their existing account to patient-level access on their very
# next request; it does not lock them out or delete anything.
ADMIN_EMAILS=

# --- Randox lab integration ---
# Which adapter handles PDF-based results. Unrelated to the API integration
# below — an admin can still upload a Randox PDF with the API switched on.
LAB_ADAPTER=RANDOX_PORTAL

# =========================================================================
# Randox API integration (Nexus Lab + Clinic Booking)
# =========================================================================
# Two separate Azure-hosted APIs. Both use Azure B2C ROPC auth and both
# require a bearer token PLUS an Ocp-Apim-Subscription-Key header on every
# request, but they have different client ids, scopes, base URLs and
# subscription keys.
#
# STATUS AT TIME OF WRITING: sandbox access is pending. The subscription
# keys, our clinic id, the agreed panel/test ids, the void/caveat code list
# and confirmation of which collection methods we may offer are all
# OUTSTANDING. Everything below is configuration for exactly that reason —
# none of it is hardcoded anywhere in the app, and the server refuses to
# boot (naming each missing variable) if RANDOX_ENABLED=true and
# RANDOX_TRANSPORT=live without them.
#
# Until then: RANDOX_ENABLED=true with RANDOX_TRANSPORT=mock runs the whole
# order → book → poll → ingest flow against in-process fixtures.

# Master switch. False: no polling job, no ordering endpoints, no config
# validation — the integration is simply not there.
RANDOX_ENABLED=false

# mock  — the entire flow against fixtures; no credentials needed.
# live  — real Randox APIs.
# Refused in production with RANDOX_ENABLED=true: mock results would be
# ingested as though they were real patient results.
RANDOX_TRANSPORT=mock

# --- Base URLs ---
# Sandbox (stes-) by default. Switching to production is these two lines.
RANDOX_NEXUS_BASE_URL=https://stes-gpto-appapi-001-apim.azure-api.net/api/
RANDOX_BOOKING_BASE_URL=https://stes-cb-platform-apim.azure-api.net/booking-platform-api/

# --- Azure B2C client ids (documented, not secret) ---
RANDOX_NEXUS_CLIENT_ID=791f0001-20d7-4771-b4ab-359b4b9efd21
RANDOX_BOOKING_CLIENT_ID=0b0399a4-d61f-43fc-a0d0-3311f60cdcb1

# --- NOT ISSUED YET: subscription keys ---
# Sent as Ocp-Apim-Subscription-Key on every request to the respective API.
# Different key per API. Required for RANDOX_TRANSPORT=live.
RANDOX_NEXUS_SUBSCRIPTION_KEY=
RANDOX_BOOKING_SUBSCRIPTION_KEY=

# --- NOT CONFIRMED YET: B2C scopes ---
# The scope string each API's ROPC token request must ask for. Typically
# api://{clientId}/.default or a named scope Randox publish.
RANDOX_NEXUS_SCOPE=
RANDOX_BOOKING_SCOPE=

# --- NOT CONFIRMED YET: B2C token endpoint ---
# The ROPC token URL, normally
# https://{tenant}.b2clogin.com/{tenant}.onmicrosoft.com/{policy}/oauth2/v2.0/token
# Set RANDOX_B2C_TOKEN_URL if both APIs share a tenant and policy; use the
# per-API overrides if they turn out to differ. We have not been able to
# confirm which, hence both being available.
RANDOX_B2C_TOKEN_URL=
RANDOX_NEXUS_TOKEN_URL=
RANDOX_BOOKING_TOKEN_URL=

# --- NOT ISSUED YET: service account credentials ---
# ROPC is a password grant, so it needs a real account. Set the shared pair
# if one account covers both APIs; use the per-API overrides otherwise.
# These are secrets — set them in Railway, never in a committed file.
RANDOX_USERNAME=
RANDOX_PASSWORD=
RANDOX_NEXUS_USERNAME=
RANDOX_NEXUS_PASSWORD=
RANDOX_BOOKING_USERNAME=
RANDOX_BOOKING_PASSWORD=

# --- NOT ISSUED YET: our clinic id ---
# Carried on every CreatePendingOrder. Without it no order can be
# attributed to this practice, so a live boot without it is refused.
RANDOX_CLINIC_ID=

# --- NOT CONFIRMED YET: permitted collection methods ---
# Comma-separated. Allowed values: IN_CLINIC, HOME_KIT, MOBILE_PHLEBOTOMY.
# Deliberately EMPTY: we do not yet have confirmation of what we are
# contractually entitled to offer, and placing an order by a route Randox
# have not agreed to is an order they will not fulfil. An order requesting
# a method not listed here is refused before anything is sent.
# Only IN_CLINIC uses the Clinic Booking API; the others have no slot.
RANDOX_COLLECTION_METHODS=

# --- NOT SUPPLIED YET: void / caveat code map ---
# JSON file mapping each Randox result code to VOID or CAVEAT.
#
#   VOID   -> the result is never shown to a patient as a value. Not greyed
#             out, not shown with a warning: no ReportResult row is written
#             at all, only an exclusion carrying a neutral "this test could
#             not be reported" note.
#   CAVEAT -> the result IS reported, with the code attached as metadata.
#             Visible to admins always; shown to patients only for codes
#             whose patientSafeNote has been filled in.
#
# A code that is NOT in this file is treated as VOID. That is the design,
# not a fallback: an unknown code is an unknown reason the lab flagged a
# number, and the only safe reading is "don't show it". Every unrecognised
# code is recorded and listed at GET /api/randox/unknown-codes, so the real
# list can be assembled from what actually arrives.
#
# The default below is a checked-in PLACEHOLDER with invented codes. A live
# boot still pointing at a .example.json file is refused.
RANDOX_CODE_MAP_FILE=./config/randox/result-codes.example.json

# --- NOT AGREED YET: panel / test id map ---
# JSON file mapping our catalogue keys to Randox's identifiers:
#   panels              our Panel.key  -> Randox panel/profile id
#   tests               our Marker.key -> Randox individual test id
#   markerNameOverrides Randox's marker name on a result -> our Marker.key
#                       (only where fuzzy name matching gets it wrong;
#                        anything unmapped is flagged for an admin in the
#                        ingestion log, never silently dropped)
# A live boot with no panels AND no tests is refused: CreatePendingOrder
# needs at least one, so no order could ever be placed.
RANDOX_ID_MAP_FILE=./config/randox/id-map.example.json

# --- Polling ---
# Randox recommend polling each outstanding order once per hour, staggered
# by order creation time. RANDOX_POLL_CRON is only how often the SWEEPER
# wakes to look for orders that are due; each order is still polled once per
# RANDOX_POLL_INTERVAL_MINUTES, on its own creation-time offset.
# Webhooks are coming; when they land, the webhook handler calls the same
# ingestion entry point and this schedule simply stops being needed.
RANDOX_POLL_CRON=*/5 * * * *
RANDOX_POLL_INTERVAL_MINUTES=60
# Orders per sweep, so a backlog spreads over several sweeps rather than
# hitting Randox in one burst.
RANDOX_POLL_BATCH_SIZE=25
# After this many consecutive failures an order stops being polled and waits
# for an admin, rather than being retried forever. It stays visible as
# stalled in GET /api/randox/orders.
RANDOX_POLL_MAX_FAILURES=12

# --- Dev/test only — NEVER true anywhere internet-reachable ---
# Returns the raw 2FA code in the login API response so local dev and e2e
# tests don't need to read it from the email provider log. Leaving this
# true in a real deployment is a full 2FA bypass.
EXPOSE_DEV_OTP_CODE=false

# --- Demo data (prisma/seedDemo.ts) ---
# SYNTHETIC patient + 4 released reports, for showing the portal before real
# patients exist. When true, the API container re-seeds it on every boot
# (idempotently, re-anchoring the report dates to "now"); unset or false and
# the boot-time call is a silent no-op. This is also the explicit opt-in that
# lets the demo seed run at all under NODE_ENV=production.
# Turn OFF and run `npm run prisma:seed:demo -- --purge --allow-production`
# before the first real patient is onboarded.
SEED_DEMO_DATA=false
# The demo patient still has to pass 2FA, so wherever email is genuinely
# being sent this must be a mailbox you can actually open.
SEED_DEMO_EMAIL=demo.showcase@aspireshield.dev
SEED_DEMO_PASSWORD=

# --- Rate limiting ---
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15
# "Send me a new code" has its own budget, separate from OTP verification:
# resend causes an outbound email/SMS, and a patient legitimately asking for
# a second code must not thereby lose the attempts they need to enter it.
# The per-attempt cooldown (30s) and reissue cap (3) in auth/service.ts are
# the primary control; this is the backstop.
OTP_RESEND_RATE_LIMIT_MAX=4
# Registration is admin-only (ADMIN_EMAILS-gated) — deliberately stricter
# and a longer window than login, since legitimate volume is a handful of
# practice staff registering once, ever.
SIGNUP_RATE_LIMIT_MAX=5
SIGNUP_RATE_LIMIT_WINDOW_MINUTES=60

# --- Web app (Vite build-time) ---
# The clinic's public phone number. Every "we couldn't get you signed in,
# call us" affordance in the app lights up when this is set, and falls back
# to the clinical-team email address when it isn't. Deliberately has no
# hard-coded default: inventing a phone number for a real medical practice
# risks sending patients to a stranger. Set it to the practice's published
# number in the Vercel environment before go-live.
VITE_CLINIC_PHONE=
