# Build-time only (Vite inlines this at build time, not read at runtime).
# Leave empty for local dev — the Vite dev server proxies /api to
# localhost:4000 (see vite.config.ts), so same-origin relative paths work.
#
# Set this in the Vercel dashboard per environment when the frontend and
# API are on different origins (Production: https://api.bloods.aspireshield.com).
VITE_API_BASE_URL=
