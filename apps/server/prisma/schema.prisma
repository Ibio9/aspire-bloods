generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  PATIENT
  ADMIN
  CLINICIAN
}

enum UserStatus {
  INVITED
  // Self-registered but the email address hasn't been proved yet. The
  // account exists and holds nothing — no results are ever attached to an
  // account in this state, and login() rejects it exactly as it rejects
  // INVITED. Becomes ACTIVE the moment the emailed six-digit code is
  // entered, which is the point 2FA enrolment begins.
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

enum TwoFactorMethod {
  EMAIL
  SMS
}

enum Sex {
  MALE
  FEMALE
  ANY
}

enum MarkerReviewStatus {
  DRAFT
  REVIEWED
  PUBLISHED
}

enum ReportStatus {
  UPLOADED
  PARSED
  ADMIN_VERIFIED
  CHANGES_REQUESTED
  CLINICIAN_REVIEWED
  RELEASED
}

enum MarkerStatus {
  IN_RANGE
  HIGH
  LOW
  SIGNIFICANT_HIGH
  SIGNIFICANT_LOW
}

enum EscalationSeverity {
  MILD
  SIGNIFICANT
}

enum ConsentType {
  DATA_PROCESSING
  RESULTS_STORAGE
  COMMS_EMAIL
  COMMS_SMS
}

enum FileKind {
  RANDOX_PDF
  ASPIRE_SUMMARY_PDF
  // The raw GetOrderResultDetail payload, stored verbatim alongside the
  // PDF. Kept because the normalised ReportResult rows are a lossy read of
  // it — anything we didn't map (or voided) is only reconstructable from
  // the original. Never patient-downloadable; admin/audit use only.
  RANDOX_RESULT_JSON
}

enum ActorType {
  USER
  SYSTEM
}

enum ErasureStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
}

// Phase 3: outcome of one attempt to ingest a result from an automated
// source (currently Randox's API). A single externalId may appear more than
// once across entries — e.g. UNMATCHED_PATIENT logged on every poll until
// the account exists, then INGESTED once it does.
enum IngestionOutcome {
  INGESTED
  PARTIAL
  DUPLICATE
  UNMATCHED_PATIENT
  FAILED
}

// ---------------------------------------------------------------------------
// Identity & auth
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  role              UserRole
  status            UserStatus @default(INVITED)
  twoFactorMethod   TwoFactorMethod @default(EMAIL)
  phoneNumberEncrypted String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Admin-initiated deactivation — distinct from the DISABLED status set by
  // the erasure-purge job (which also anonymises the profile). Deactivation
  // blocks login and revokes existing sessions but retains all data
  // untouched, and is reversible. deactivatedAt is the marker that
  // distinguishes "deactivated" from "erased" even though both currently
  // set status: DISABLED.
  deactivatedAt       DateTime?
  deactivatedById      String?
  deactivatedBy        User?     @relation("DeactivatedByStaff", fields: [deactivatedById], references: [id])
  deactivationReason   String?
  deactivatedAccounts  User[]    @relation("DeactivatedByStaff")

  patientProfile    PatientProfile?
  staffProfile      StaffProfile?
  inviteTokens      InviteToken[]
  emailVerificationCodes EmailVerificationCode[]
  passwordResetTokens PasswordResetToken[]
  otpCodes          OtpCode[]
  refreshTokens     RefreshToken[]
  trustedDevices    TrustedDevice[]
  consentRecords    ConsentRecord[]
  erasureRequests   ErasureRequest[]
  auditLogEntries   AuditLogEntry[] @relation("ActorUser")

  reportsAsPatient  Report[] @relation("PatientReports")
  reportsUploaded   Report[] @relation("UploadedByStaff")
  reportsVerified   Report[] @relation("VerifiedByStaff")
  reportsReviewed   Report[] @relation("ReviewedByStaff")
  reportsVoided     Report[] @relation("VoidedByStaff")
  resultEdits       ReportResultEdit[] @relation("ResultEditedByStaff")

  randoxOrders       RandoxOrder[] @relation("PatientRandoxOrders")
  randoxOrdersPlaced RandoxOrder[] @relation("RandoxOrderPlacedByStaff")
}

model PatientProfile {
  id                              String   @id @default(uuid())
  userId                          String   @unique
  user                            User     @relation(fields: [userId], references: [id])
  title                           String?
  firstName                       String
  lastName                        String
  sex                             Sex?
  // DOB and contact number are the two fields an admin matches an incoming
  // result against (see modules/admin/linkingService.ts), so both are
  // captured at self-signup and stay required. Address and postcode are
  // not part of that decision and are optional — they're asked for at
  // invite-activation, and can be filled in later otherwise.
  dobEncrypted                    String
  contactNumberEncrypted          String
  addressEncrypted                String?
  postcode                        String?
  gpName                          String?
  gpAddressEncrypted              String?
  medicationEncrypted              String?
  allergiesEncrypted              String?
  emergencyContactName            String?
  emergencyContactNumberEncrypted String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
}

model StaffProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  firstName    String
  lastName     String
  postNominals String?
  roleTitle    String?
  createdAt    DateTime @default(now())
}

model InviteToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Self-registration only. Deliberately a separate model from InviteToken
// even though both prove something about an address: an invite is the
// practice vouching for someone and carries a 7-day expectation, whereas
// this is only ever "prove you can read this mailbox" and is short-lived.
// Conflating them would mean one TTL, one audit action, and one revocation
// story for two genuinely different events.
//
// A six-digit code emailed to confirm a new account's address — the same
// shape as OtpCode on purpose, because it is the same interaction: one code
// to verify, one code to sign in, one mental model.
//
// codeHash is deliberately NOT unique. Six digits across a whole user base
// will collide, and a unique index would turn that collision into a failed
// registration for whoever came second. Codes are only ever looked up
// alongside the account they were issued to.
model EmailVerificationCode {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  // Capped, like OtpCode's — six digits is a million-wide search space, so
  // an uncapped code is a guessable one.
  attempts    Int       @default(0)
  // Carried forward across reissues so the cap is per registration attempt
  // rather than per row.
  resendCount Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// "I've forgotten my password." A third token model rather than a reuse of
// either of the two above, for the same reason those two are separate: the
// TTL, the audit action and the revocation story all differ. This one is the
// shortest-lived of the three and the only one whose use invalidates every
// existing session — resetting a password is the action someone takes when
// they suspect they've lost control of the account, so it has to end any
// session they didn't start.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model OtpCode {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  codeHash    String
  channel     TwoFactorMethod
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int             @default(0)
  // How many times the patient has asked us to send the code again within
  // this one login attempt. Carried forward across reissues so the count is
  // per-challenge-chain, not per-row — that's what lets us offer a way out
  // (call the clinic) after two or three failed deliveries instead of
  // letting someone loop forever on an address that isn't receiving.
  resendCount Int             @default(0)
  createdAt   DateTime        @default(now())

  @@index([userId])
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  @@index([userId])
}

model TrustedDevice {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  deviceIdHash String
  trustedUntil DateTime
  createdAt    DateTime @default(now())

  @@unique([userId, deviceIdHash])
}

// ---------------------------------------------------------------------------
// Consent
// ---------------------------------------------------------------------------

model ConsentVersion {
  id            String   @id @default(uuid())
  type          ConsentType
  version       Int
  bodyText      String
  effectiveFrom DateTime @default(now())
  records       ConsentRecord[]

  @@unique([type, version])
}

model ConsentRecord {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  consentVersionId String
  consentVersion   ConsentVersion @relation(fields: [consentVersionId], references: [id])
  granted          Boolean
  ipAddress        String
  createdAt        DateTime       @default(now())
  withdrawnAt      DateTime?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Panels, markers, reference ranges, explanation copy — fully data-driven
// ---------------------------------------------------------------------------

model Panel {
  id          String        @id @default(uuid())
  key         String        @unique
  name        String
  description String?
  isActive    Boolean       @default(true)
  // False until an admin explicitly confirms this panel's marker list
  // against the real Randox panel spec via the panel editor. Seeded panels
  // start false (composition was guessed from public positioning, not a
  // spec sheet — see prisma/seed.ts). Any admin edit through the panel
  // editor (add/remove/reorder) flips it true — the point isn't to gate
  // functionality, only to stop the guessed default from looking verified.
  compositionConfirmed Boolean @default(false)
  markers     PanelMarker[]
  reports     Report[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Marker {
  id                     String             @id @default(uuid())
  key                    String             @unique
  name                   String
  defaultUnit            String
  severityMultiplier     Float              @default(1.5)
  severityAbsoluteDelta  Float?
  // Mirrors Panel.isActive — lets an admin retire a marker Randox can no
  // longer supply (or that was seeded in error) without breaking the FK
  // history of any report that already used it. Excluded markers are
  // filtered out of the picker endpoints but never deleted.
  isActive               Boolean            @default(true)
  // Phase 2 §2.4: whether it's safe to plot this marker's results across
  // multiple sources on one trend line. Defaults true; set false for a
  // marker where sources report genuinely incompatible values (no
  // reliable conversion) — the chart then says so instead of drawing a
  // misleading line. Also overridden at read-time if a conversion a
  // series actually needs isn't in the registry (lib/unitConversion.ts),
  // regardless of this flag — never draw a guess.
  crossSourceComparable  Boolean            @default(true)
  panels                 PanelMarker[]
  exclusions             ReportResultExclusion[]
  referenceRanges        ReferenceRange[]
  explanation            MarkerExplanation?
  results                ReportResult[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

// Phase 2 §2.2: every result set records where it came from. Admin-
// extensible without a deploy; seeded with randox_pdf, aspire_inhouse,
// manual_entry. No source may bypass the clinician review gate — that's
// enforced by the Report state machine itself, not by anything here.
model Source {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  reports   Report[]
}

model PanelMarker {
  id        String @id @default(uuid())
  panelId   String
  panel     Panel  @relation(fields: [panelId], references: [id])
  markerId  String
  marker    Marker @relation(fields: [markerId], references: [id])
  sortOrder Int    @default(0)
  isAddOn   Boolean @default(false)

  @@unique([panelId, markerId])
  @@index([markerId])
}

model ReferenceRange {
  id        String   @id @default(uuid())
  markerId  String
  marker    Marker   @relation(fields: [markerId], references: [id])
  sex       Sex      @default(ANY)
  ageMin    Int?
  ageMax    Int?
  unit      String
  low       Float
  high      Float
  source    String?
  createdAt DateTime @default(now())
  results   ReportResult[]

  @@index([markerId])
}

model MarkerExplanation {
  id               String             @id @default(uuid())
  markerId         String             @unique
  marker           Marker             @relation(fields: [markerId], references: [id])
  whatItIs         String
  highMeans        String?
  lowMeans         String?
  lifestyleContext String?
  reviewStatus     MarkerReviewStatus @default(DRAFT)
  reviewedById     String?
  reviewedAt       DateTime?
  version          Int                @default(1)
  updatedAt        DateTime           @updatedAt
}

// ---------------------------------------------------------------------------
// Reports — the release state machine
// ---------------------------------------------------------------------------

model Report {
  id           String       @id @default(uuid())
  patientId    String
  patient      User         @relation("PatientReports", fields: [patientId], references: [id])
  // Optional: a report does not have to come from a catalogue panel. Aspire
  // runs its own testing and one-off markers alongside packaged Randox
  // panels, so a single repeat test or a marker added outside any package is
  // a legitimate report with no panel behind it. Null means "individual
  // markers"; every downstream read path (title, PDF, exports, search) must
  // treat the panel as absent-able and fall back to a self-explanatory
  // title — see shared/format.ts formatReportTitle().
  panelId      String?
  panel        Panel?       @relation(fields: [panelId], references: [id])
  sourceId     String
  source       Source       @relation(fields: [sourceId], references: [id])
  // Randox's own identifier for this result set (order/report id) — set only
  // for API-ingested reports. Unique so a redelivered payload updates the
  // same report instead of creating a duplicate (Postgres allows multiple
  // NULLs under a unique constraint, so PDF/manual reports are unaffected).
  externalId   String?      @unique
  sampleDate   DateTime
  receivedDate DateTime     @default(now())
  status       ReportStatus @default(UPLOADED)

  // Nullable: automated ingestion (RandoxApiAdapter) has no staff uploader —
  // that attempt is attributed via IngestionLogEntry + an actorType SYSTEM
  // audit log entry instead. Every human-initiated route (PDF upload,
  // manual entry) still always sets this.
  uploadedById String?
  uploadedBy   User?     @relation("UploadedByStaff", fields: [uploadedById], references: [id])
  verifiedById String?
  verifiedBy   User?     @relation("VerifiedByStaff", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("ReviewedByStaff", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  releasedAt   DateTime?

  // Void is a state change, not a deletion — the row, every ReportResult,
  // and the full audit trail all stay intact. Voided reports are filtered
  // out of every patient-facing query but remain visible (marked) to admins.
  voidedAt     DateTime?
  voidedById   String?
  voidedBy     User?     @relation("VoidedByStaff", fields: [voidedById], references: [id])
  voidReason   String?

  originalPdfFileId String?     @unique
  originalPdfFile   StoredFile? @relation("OriginalPdf", fields: [originalPdfFileId], references: [id])
  generatedFiles    StoredFile[] @relation("GeneratedFiles")

  results             ReportResult[]
  escalationEvents    EscalationEvent[]
  ingestionLogEntries IngestionLogEntry[]
  // Markers the lab could not report (void codes). Deliberately NOT
  // ReportResult rows: a voided value must have no row anywhere a patient
  // read path could reach it. See ReportResultExclusion.
  exclusions          ReportResultExclusion[]
  measurements        ReportMeasurements?
  randoxOrder         RandoxOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([panelId])
  @@index([sourceId])
}

model ReportResult {
  id               String         @id @default(uuid())
  reportId         String
  report           Report         @relation(fields: [reportId], references: [id])
  markerId         String
  marker           Marker         @relation(fields: [markerId], references: [id])
  valueEncrypted   String
  unit             String
  referenceRangeId String
  referenceRange   ReferenceRange @relation(fields: [referenceRangeId], references: [id])
  status           MarkerStatus
  rawParsedValue   String?
  createdAt        DateTime       @default(now())

  // Lab caveat codes carried on this result (Randox API only; empty for
  // every other source). Caveats qualify a result that IS reportable —
  // anything that makes a result unreportable is a void code, and voided
  // markers never become a ReportResult at all (see ReportResultExclusion).
  // Surfaced to admins always; surfaced to patients only for codes whose
  // patientSafeNote is filled in in the code map.
  caveatCodes      String[]       @default([])

  // Randox's own out-of-range indicator (`lowHigh`), verbatim. Advisory
  // only: `status` above is always computed from the value against the
  // range, never copied from here.
  labStatusIndicator String?
  // True when the lab's indicator and our computed status disagree. Neither
  // is silently preferred — the disagreement is surfaced to an admin,
  // because it usually means the range we parsed is not the range the lab
  // applied, and quietly picking either answer would hide that.
  labStatusDisagrees Boolean       @default(false)

  // Set (and refreshed) whenever a RELEASED report's value is amended —
  // never on the pre-release verify/re-verify overwrite path, which isn't
  // "amendment" since nothing has been shown to the patient yet. Patient
  // view shows the current value plus "amended on {amendedAt}".
  amendedAt DateTime?
  edits     ReportResultEdit[]

  @@unique([reportId, markerId])
  @@index([markerId])
}

// One immutable row per post-release edit — versioned, never overwritten.
// A RELEASED report's ReportResult itself still holds only the CURRENT
// value (so every other read path doesn't need to know about history), but
// every prior value is preserved here with who changed it, when, and why.
model ReportResultEdit {
  id                  String       @id @default(uuid())
  reportResultId      String
  reportResult        ReportResult @relation(fields: [reportResultId], references: [id])
  previousValueEncrypted String
  previousUnit        String
  previousStatus      MarkerStatus
  newValueEncrypted   String
  newUnit             String
  newStatus           MarkerStatus
  reason              String
  changedById         String
  changedBy           User         @relation("ResultEditedByStaff", fields: [changedById], references: [id])
  changedAt           DateTime     @default(now())

  @@index([reportResultId])
}

model StoredFile {
  id               String   @id @default(uuid())
  kind             FileKind
  storageKey       String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime @default(now())

  originalForReport   Report? @relation("OriginalPdf")
  generatedForReportId String?
  generatedForReport   Report? @relation("GeneratedFiles", fields: [generatedForReportId], references: [id])

  @@index([generatedForReportId])
}

// ---------------------------------------------------------------------------
// Escalation
// ---------------------------------------------------------------------------

model EscalationEvent {
  id               String             @id @default(uuid())
  reportId         String
  report           Report             @relation(fields: [reportId], references: [id])
  severity         EscalationSeverity
  channelsNotified String[]
  flaggedMarkerIds String[]
  createdAt        DateTime           @default(now())
  acknowledgedAt   DateTime?

  @@index([reportId])
}

// ---------------------------------------------------------------------------
// Ingestion log — every automated-source attempt, success or not, so a
// silently failed import doesn't go unnoticed (Phase 3 §3).
// ---------------------------------------------------------------------------

model IngestionLogEntry {
  id         String           @id @default(uuid())
  sourceKey  String
  externalId String?
  outcome    IngestionOutcome
  reportId   String?
  report     Report?          @relation(fields: [reportId], references: [id])
  // Markers successfully mapped and written on this attempt.
  markerCount Int             @default(0)
  message    String
  // Per-row detail for anything skipped: unknown marker key, implausible
  // unit, unmatched patient reference, etc. Structure is source-specific.
  mappingFailures Json?
  createdAt  DateTime         @default(now())

  @@index([sourceKey])
  @@index([externalId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Unmatched results — a result set that arrived without a patient account we
// could attach it to. Now that anyone can register, most inbound results will
// land here first: the account and the lab order are created independently and
// nothing ties them together automatically.
//
// This is deliberately NOT a Report with a null patientId. A Report is a thing
// that belongs to someone — every read path in the app assumes that, and the
// release state machine is built on it. An unmatched result belongs to nobody
// yet, so it lives outside that machine entirely until an admin says whose it
// is. Linking then creates the Report; it never mutates one into existence
// behind the state machine's back.
// ---------------------------------------------------------------------------

enum UnmatchedResultStatus {
  PENDING
  LINKED
  DISMISSED
}

model UnmatchedResult {
  id         String  @id @default(uuid())
  sourceKey  String
  // The lab's own id for this result set. Unique so a redelivery updates the
  // same pending row rather than stacking up duplicates in the admin queue.
  externalId String? @unique

  // Identity exactly as the LAB stated it — never as we guessed it. This is
  // the entirety of what an admin has to match against, so it's stored
  // verbatim and encrypted like every other identifier we hold.
  claimedFirstName              String?
  claimedLastName               String?
  claimedDobEncrypted           String?
  claimedContactNumberEncrypted String?

  sampleDate  DateTime?
  markerCount Int       @default(0)
  // The normalised ParsedReport, kept whole so linking can replay it through
  // the ordinary ingestion path. Nothing is thrown away while we wait.
  payload     Json

  status UnmatchedResultStatus @default(PENDING)

  // Set on link; cleared again on unlink, which returns the row to PENDING so
  // it goes straight back into the queue rather than disappearing. No hard
  // deletes — a dismissed row keeps its reason and its dismisser forever.
  linkedReportId  String?
  linkedPatientId String?
  linkedById      String?
  linkedAt        DateTime?
  dismissedAt     DateTime?
  dismissedById   String?
  dismissReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([sourceKey])
}

// ---------------------------------------------------------------------------
// Editable clinical copy (single place for GP-contact prompt, disclaimers)
// ---------------------------------------------------------------------------

model CopyBlock {
  id        String   @id @default(uuid())
  slug      String   @unique
  body      String
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Audit log — insert-only
// ---------------------------------------------------------------------------

model AuditLogEntry {
  id          String    @id @default(uuid())
  actorUserId String?
  actorUser   User?     @relation("ActorUser", fields: [actorUserId], references: [id])
  actorType   ActorType @default(USER)
  action      String
  targetType  String
  targetId    String?
  ipAddress   String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([actorUserId])
  @@index([createdAt])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Retention & erasure
// ---------------------------------------------------------------------------

model RetentionPolicy {
  id                  String    @id @default(uuid())
  dataType            String    @unique
  retentionPeriodDays Int
  lastReviewedAt      DateTime?
  createdAt           DateTime  @default(now())
}

model ErasureRequest {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  status           ErasureStatus @default(REQUESTED)
  requestedAt      DateTime      @default(now())
  purgeScheduledAt DateTime?
  purgedAt         DateTime?
  notes            String?

  @@index([userId])
}

// Backs the login/signup/OTP rate limiters with a store that survives
// restarts and redeploys — the default express-rate-limit store is
// in-memory and silently resets protection on every Railway deploy.
model RateLimitHit {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@index([resetAt])
}

enum DemoSeedOutcome {
  // SEED_DEMO_DATA was not set to "true", so the boot-mode call did nothing.
  SKIPPED
  SUCCEEDED
  FAILED
}

// The outcome of the last boot-mode demo-data seed (prisma/seedDemo.ts).
//
// That seed's failures are deliberately swallowed so synthetic demo data can
// never stop the API booting — which means a failure and a deliberate no-op
// look identical from outside: an account that signs in and has nothing in it.
// The swallow is right; the silence isn't. This row is what an admin reads to
// tell the two apart without shell access to the deploy logs.
//
// Exactly one row, keyed on a constant and overwritten on every boot. History
// is not useful here — only the state of the deployment you are looking at is,
// and an unbounded log of "skipped" on a service that never wanted demo data
// would be pure noise.
model DemoSeedRun {
  id             String          @id @default("last")
  outcome        DemoSeedOutcome
  ranAt          DateTime        @default(now())
  durationMs     Int?
  reportsCreated Int             @default(0)
  // Masked (maskEmail) — SEED_DEMO_EMAIL is a real mailbox in any environment
  // where 2FA email is genuinely delivered, so it is not stored in full.
  patientEmail   String?
  /// One line, always set: what happened, in the terms an admin needs.
  detail         String
  /// Error message only, never a stack — stacks belong in the deploy logs.
  errorMessage   String?
}

// ---------------------------------------------------------------------------
// Randox API integration (Nexus Lab + Clinic Booking)
// ---------------------------------------------------------------------------

// Randox's numeric order statuses, named. The wire values are 1–5 and are
// mapped in modules/randox/types.ts — an unrecognised numeric status is
// never coerced into one of these; it leaves the order on its previous
// status and is logged, because guessing "probably complete" on an unknown
// code is exactly how an unreleased result would leak.
enum RandoxOrderStatus {
  INCOMPLETE // 1
  SUBMITTED // 2
  PENDING_RESULTS // 3
  COMPLETE // 4
  CANCELLED // 5
}

// Which sample collection routes the practice is contractually entitled to
// offer. Nothing here is enabled by default — RANDOX_COLLECTION_METHODS
// gates it, because offering a method Randox hasn't agreed to would create
// an order they will not fulfil. See modules/randox/config.ts.
enum RandoxCollectionMethod {
  IN_CLINIC
  HOME_KIT
  MOBILE_PHLEBOTOMY
}

enum RandoxAppointmentStatus {
  HELD // HoldAvailabilityBooking succeeded; 30-minute window running
  BOOKED // CreateRandoxBooking confirmed
  CANCELLED
  EXPIRED // the hold lapsed before CreateRandoxBooking was called
}

// One row per order placed with Randox Nexus. orderNumber is Randox's own
// Order Number, the reference every downstream call (booking, status,
// results) is keyed on — and the idempotency key for result delivery.
model RandoxOrder {
  id          String            @id @default(uuid())
  orderNumber String            @unique
  // Randox issue TWO identifiers per order and several endpoints want both
  // plus the clinic id together (GetOrderResultDetail, GetOrderResultReports,
  // CancelOrder). Both are stored rather than one being derived.
  //
  // orderNumber is the string reference the flow documentation calls "the
  // main reference id", and is what CreateRandoxBooking carries as
  // GPExternalNumber. Note CreatePendingOrder returns it under the name
  // `externalNumber`, NOT `orderNumber` — see clients/NexusLabClient.ts.
  //
  // randoxOrderId is the integer CreatePendingOrder returns as `orderId`.
  // Nullable only because rows created before it was captured may exist;
  // an order without it cannot be polled and is stalled explicitly.
  randoxOrderId Int?            @unique
  // The clinic this order belongs to, captured at order time rather than
  // read from config at call time: config can change, and a request about
  // an old order must carry the clinic id that order actually belongs to.
  clinicId    Int?
  patientId   String
  patient     User              @relation("PatientRandoxOrders", fields: [patientId], references: [id])
  // Staff member who placed it. Null for anything system-initiated.
  placedById  String?
  placedBy    User?             @relation("RandoxOrderPlacedByStaff", fields: [placedById], references: [id])

  // Randox's panel/test identifiers exactly as submitted — stored raw so a
  // later change to the configured ID map never rewrites the history of
  // what was actually ordered.
  randoxPanelIds String[]       @default([])
  randoxTestIds  String[]       @default([])

  collectionMethod RandoxCollectionMethod
  status           RandoxOrderStatus @default(INCOMPLETE)
  // The raw numeric status last seen on the wire, including values we don't
  // recognise — kept so an unmapped status is diagnosable.
  rawStatusCode    Int?

  // Set once results have been ingested. Unique: one Randox order produces
  // at most one Report, which is what makes redelivery idempotent.
  reportId String? @unique
  report   Report? @relation(fields: [reportId], references: [id])

  // Polling state. nextPollAt is staggered off createdAt (Randox ask for
  // hourly polling spread across the hour) and backs off on failure. A
  // future webhook sets these to null and calls the same ingestion entry
  // point — see modules/randox/pollingJob.ts.
  nextPollAt       DateTime?
  lastPolledAt     DateTime?
  pollAttempts     Int       @default(0)
  consecutiveFailures Int    @default(0)
  lastPollError    String?

  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  appointment RandoxAppointment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([status, nextPollAt])
}

// In-clinic collection only. Held then booked: HoldAvailabilityBooking
// reserves a slot for 30 minutes, CreateRandoxBooking confirms it against
// the Nexus order number (sent as GPExternalNumber).
model RandoxAppointment {
  id      String      @id @default(uuid())
  orderId String      @unique
  order   RandoxOrder @relation(fields: [orderId], references: [id])

  serviceLocationId   String
  serviceLocationName String?

  holdReference    String?
  holdExpiresAt    DateTime?
  bookingReference String?

  // Randox return availability in UTC; stored as UTC and only ever
  // localised at render time.
  startUtc DateTime
  endUtc   DateTime?

  status      RandoxAppointmentStatus @default(HELD)
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startUtc])
}

// A marker the lab could not report. This exists instead of a ReportResult
// so that a voided value is not merely hidden at render time — there is no
// row holding it anywhere. Patient-facing surfaces show a count and a
// neutral note; the code and reason are admin-only.
model ReportResultExclusion {
  id       String  @id @default(uuid())
  reportId String
  report   Report  @relation(fields: [reportId], references: [id])
  // Null when the incoming marker name didn't match our catalogue at all —
  // the exclusion is still recorded, keyed on rawMarkerName.
  markerId String?
  marker   Marker? @relation(fields: [markerId], references: [id])

  rawMarkerName String
  // The void code as received. Null when the result was excluded for a
  // reason other than a code (e.g. no value supplied at all).
  code String?
  // False when the code was NOT in the configured map — treated as void by
  // default. See modules/randox/codes.ts.
  codeRecognised Boolean @default(false)
  // Admin-facing explanation. Never shown to a patient.
  reason String

  createdAt DateTime @default(now())

  @@unique([reportId, rawMarkerName])
  @@index([reportId])
  @@index([markerId])
}

// Every void/caveat code Randox has actually sent us that isn't in the
// configured map. The real code list isn't available yet, so this table is
// how we find out what's genuinely arriving rather than guessing — an
// admin screen reads it and the list gets folded into the code map config.
model RandoxUnknownCode {
  code        String   @id
  sightings   Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  // One example so the code can be traced back to a real order.
  sampleOrderNumber String?
  sampleMarkerName  String?

  @@index([lastSeenAt])
}

// Patient measurements Randox return alongside results
// (GetOrderResultDetail). Recorded at collection, not derived from the
// blood sample — height, weight, blood pressure, smoking status and so on,
// which is why they sit beside the results rather than among them.
//
// Kept in their own table rather than as columns on Report: every field is
// optional, most reports have none of them, and they are a different KIND
// of data from a lab result (self-reported or clinic-measured, not
// assayed). No patient-facing UI reads this yet — it is stored because
// discarding data the lab has already sent us means it cannot be recovered
// later, and because IsCvScoreRequired depends on several of these fields.
model ReportMeasurements {
  id       String @id @default(uuid())
  reportId String @unique
  report   Report @relation(fields: [reportId], references: [id])

  heightCm    Float?
  weightKg    Float?
  waistCm     Float?
  hipCm       Float?
  pulseBpm    Int?
  systolicBp  Int?
  diastolicBp Int?

  isDiabetic                  Boolean?
  isSmoker                    Boolean?
  knownVascularDisease        Boolean?
  onMedicationForHypertension Boolean?
  // Biological sex as the LAB recorded it against this sample, captured at
  // order time and echoed back on the result payload. Deliberately not a
  // duplicate of PatientProfile.sex: that is the account holder's own answer
  // and is optional at registration. The optimal-range resolver prefers the
  // account value and falls back to this one (see lib/optimalRange.ts), so a
  // patient who never filled the field in still gets a sex-specific band.
  // Null for every source that doesn't report it — PDF upload, manual entry.
  biologicalSex               Sex?
  // Free text as Randox report it, not our Sex/Ethnicity enum — this is
  // their vocabulary (see GetEthnicity) and mapping it into one of ours
  // would lose the distinction between "not asked" and "not recorded".
  ethnicity                   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A cached copy of Randox's own reference data (panels, tests, biological
// sexes, ethnicities, testing reasons, cancellation reasons, clinic
// details). Fetched from the self-serve endpoints rather than hardcoded,
// because our catalogue was seeded from a pricing email and Randox's live
// list is the authority on what can actually be ordered.
//
// One row per (kind, randoxId). Refreshed wholesale; rows that disappear
// from Randox are marked stale rather than deleted, so an order placed
// against a since-withdrawn panel can still be explained.
model RandoxCatalogueEntry {
  id       String              @id @default(uuid())
  kind     RandoxCatalogueKind
  // Randox's own id, as a string regardless of whether they type it as an
  // integer — GetBiologicalSex returns "1" and GetEthnicity returns 1.
  randoxId String
  name     String
  code     String?
  // The whole entry as returned, so a field we don't model yet (sample
  // tubes, fasting requirement, cost) is not lost.
  payload  Json?

  // Our catalogue key this maps to (Panel.key / Marker.key), set by an admin
  // on the mapping screen. Null means unmapped — which is not an error, but
  // is surfaced prominently because an unmapped panel cannot be ordered.
  mappedKey String?
  mappedAt  DateTime?

  // False once Randox stop returning it. Never deleted.
  isCurrent   Boolean  @default(true)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([kind, randoxId])
  @@index([kind, isCurrent])
}

enum RandoxCatalogueKind {
  PANEL
  TEST
  BIOLOGICAL_SEX
  ETHNICITY
  TESTING_REASON
  CANCELLATION_REASON
  CLINIC_LOCATION
}
